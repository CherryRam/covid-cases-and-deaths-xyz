{
	"name": "df_transform_cases_and_deaths_xyz",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_raw_cases_and_deaths_xyz",
						"type": "DatasetReference"
					},
					"name": "CasesAndDeathsSourceXYZ",
					"description": "Import data from df_raw_cases_and_deaths_xyz"
				},
				{
					"dataset": {
						"referenceName": "ds_country_lookup_xyz",
						"type": "DatasetReference"
					},
					"name": "CountryLookupXYZ"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_processed_cases_and_deaths_xyz",
						"type": "DatasetReference"
					},
					"name": "CasesAndDeathsSinkXYZ"
				}
			],
			"transformations": [
				{
					"name": "FilterEuropeOnlyXYZ"
				},
				{
					"name": "SelectOnlyRequiredFieldsXYZ"
				},
				{
					"name": "PivotCountsXYZ"
				},
				{
					"name": "lookupCountryXYZ"
				},
				{
					"name": "SelectForSinkXYZ"
				}
			],
			"scriptLines": [
				"source(output(",
				"          country as string,",
				"          country_code as string,",
				"          continent as string,",
				"          population as integer,",
				"          indicator as string,",
				"          daily_count as integer,",
				"          date as date,",
				"          rate_14_day as double,",
				"          source as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> CasesAndDeathsSourceXYZ",
				"source(output(",
				"          country as string,",
				"          country_code_2_digit as string,",
				"          country_code_3_digit as string,",
				"          continent as string,",
				"          population as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> CountryLookupXYZ",
				"CasesAndDeathsSourceXYZ filter(continent == 'Europe' && not(isNull(country_code))) ~> FilterEuropeOnlyXYZ",
				"FilterEuropeOnlyXYZ select(mapColumn(",
				"          country,",
				"          country_code,",
				"          population,",
				"          indicator,",
				"          daily_count,",
				"          source,",
				"          each(match(name=='date'),",
				"               'reported'+'_date' = $$)",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> SelectOnlyRequiredFieldsXYZ",
				"SelectOnlyRequiredFieldsXYZ pivot(groupBy(country,",
				"          country_code,",
				"          population,",
				"          source,",
				"          reported_date),",
				"     pivotBy(indicator, ['confirmed cases', 'deaths']),",
				"     count = sum(daily_count),",
				"     columnNaming: '$V_$N',",
				"     lateral: true) ~> PivotCountsXYZ",
				"PivotCountsXYZ, CountryLookupXYZ lookup(PivotCountsXYZ@country == CountryLookupXYZ@country,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupCountryXYZ",
				"lookupCountryXYZ select(mapColumn(",
				"          country = PivotCountsXYZ@country,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          population = PivotCountsXYZ@population,",
				"          cases_count = {confirmed cases_count},",
				"          deaths_count,",
				"          reported_date,",
				"          source",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectForSinkXYZ",
				"SelectForSinkXYZ sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['cases_and_deaths_xyz.csv'],",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> CasesAndDeathsSinkXYZ"
			]
		}
	}
}